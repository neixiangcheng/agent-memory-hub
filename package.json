{
  "name": "agent-memory-hub",
  "version": "0.3.0",
  "description": "One shared memory store for every local AI coding agent: MCP server, declarative adapters, a DeepSeek Harness bundle and a read-only viewer.",
  "keywords": [
    "ai",
    "agents",
    "agent-memory",
    "memory",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "cursor",
    "qoder",
    "deepseek-harness",
    "cli"
  ],
  "license": "MIT",
  "author": "neixiangcheng",
  "homepage": "https://github.com/neixiangcheng/agent-memory-hub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neixiangcheng/agent-memory-hub.git"
  },
  "bugs": {
    "url": "https://github.com/neixiangcheng/agent-memory-hub/issues"
  },
  "type": "module",
  "bin": {
    "amh": "bin/amh.mjs"
  },
  "exports": {
    ".": "./dist/mcp-server.js",
    "./cli": "./dist/cli.js",
    "./web": "./dist/web.js"
  },
  "files": [
    "bin",
    "dist",
    "adapters",
    "plugins",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "amh": "node src/cli.ts",
    "serve": "node src/mcp-server.ts",
    "web": "node src/cli.ts web",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "try:pack": "node scripts/pack-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
