  "description": "DeepSeek Harness bundle: injects agent-memory-hub memories into the model context; optional memory_write/memory_search tools",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./tool": "./tool.js",
    "./package.json": "./package.json"
