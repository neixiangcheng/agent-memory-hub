  "files": ["index.js", "tool.js", "tools-def.js", "cordis.patch.yml", "cordis.tools.patch.yml"],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": { "optional": true }
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
}
